#!/usr/bin/env bash
# MANUAL HEADED RUN — FOR THE OPERATOR AT THE DESKTOP, WITH THE OPERATOR PRESENT.
# DO NOT RUN HEADLESS, DO NOT RUN IT FROM AN AGENT, AND NEVER LET AN AGENT PRESS
# THE KEYS: the point is that a human witnesses focus, notification and placement.
#
# L28 (milestone 6, service packaging) with L18 (milestone 4, human handoff) folded in.
# One headed pass over the installed unit:
#
#   1. prints the exact install steps from docs/install.md (home-manager or hand
#      install) and waits for the operator to confirm the unit is installed;
#   2. checks the unit is active and "leash status" is healthy;
#   3. records what niri does with the managed window (app-id "leash"): the rule's
#      placement, and the focus move a handoff causes — "niri msg --json windows" plus
#      workspace names, before and after;
#   4. runs the L27 skill workflow from the operator's shell by handle:
#      new / snap --match / fill / click / text / shot / debug / close on a page this
#      script serves on 127.0.0.1, and checks the journal carries cmd;
#   5. triggers one real handoff (niri focus + notify-send Done action; L18's content)
#      and asks whether the window was focused, whether the notification appeared, and
#      whether clicking Done resumed it;
#   6. restarts the unit and checks a fresh Chrome generation comes up with the profile
#      intact and the old tabs gone, then stops it and checks the exit status, the
#      socket, Chrome and the journal;
#   7. writes /tmp/leash-m6-headed-result.txt (every answer and measurement) and keeps
#      L18's file /tmp/leash-m4-headed-result.txt in scripts/live-acceptance-m4-headed's
#      own field names, so the human-handoff spec's promise still holds.
#
# Nothing here installs, builds or starts Chrome itself: the unit's service does. The
# niri rule stays the operator's to add (docs/install.md).
# scripts/live-acceptance-m4-headed remains available for a separate throwaway-profile
# run of L18 alone; this run does not need it.
#
# Optional L34 Allegro operator step (not part of unattended L28 verification):
# after this headed gate, while the operator is present, open a fresh agent tab
# on https://allegro.pl/ through the installed service. If the headed site permits
# access, run the product search -> offer -> add to cart -> cart mission with
# --expect "the page is cart", inspect the cart, and stop BEFORE checkout/payment.
# Record whether DataDome still blocks access. Do not evade the bot wall and do
# not ask an unattended agent to control the headed desktop.
#
# Usage: scripts/live-acceptance-m6-headed [--dry-run] [--yes] [--leash PATH]
#                                          [--result FILE] [--m4-result FILE]
#                                          [--handoff-timeout-s N]
# Result: /tmp/leash-m6-headed-result.txt and /tmp/leash-m4-headed-result.txt
set -euo pipefail

dry=0
assume_yes=0
leash_override=""
result_file="/tmp/leash-m6-headed-result.txt"
m4_result_file="/tmp/leash-m4-headed-result.txt"
handoff_timeout_s=300

usage() {
  cat <<'EOF'
scripts/live-acceptance-m6-headed — the milestone-6 headed acceptance (L28), run by the
operator at the desktop; it carries L18's headed handoff check and writes both result files.

Usage: scripts/live-acceptance-m6-headed [options]

Options:
  --dry-run              Print every step, question and command without touching systemd,
                         Chrome, the control socket or the network. Writes <result>.dry-run.
  --yes                  Answer every question with its default (unattended; not advised).
  --leash PATH           The leash CLI to use. Default: the ExecStart binary of the
                         installed leash.service (the service's own CLI).
  --result FILE          Result file (default /tmp/leash-m6-headed-result.txt).
  --m4-result FILE       L18 result file (default /tmp/leash-m4-headed-result.txt).
  --handoff-timeout-s N  How long the handoff waits for Done (default 300).
  -h, --help             This text.

Read docs/install.md first. The script prints the install steps and installs nothing.
It starts no Chrome itself: the unit's service does, and it puts a window on your desktop.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --yes) assume_yes=1; shift ;;
    --leash) leash_override="${2:?--leash needs a path}"; shift 2 ;;
    --result) result_file="${2:?--result needs a path}"; shift 2 ;;
    --m4-result) m4_result_file="${2:?--m4-result needs a path}"; shift 2 ;;
    --handoff-timeout-s) handoff_timeout_s="${2:?--handoff-timeout-s needs a number}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ ! "$handoff_timeout_s" =~ ^[0-9]+$ || "$handoff_timeout_s" -lt 5 ]]; then
  echo "--handoff-timeout-s must be an integer of at least 5 seconds" >&2
  exit 2
fi
if (( dry == 0 )) && [[ ! -t 0 || ! -t 1 ]] && (( assume_yes == 0 )); then
  echo "this is an interactive acceptance: run it in a terminal, or pass --yes" >&2
  exit 2
fi
if (( dry == 1 )); then
  result_file="${result_file}.dry-run"
  m4_result_file="${m4_result_file}.dry-run"
fi

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="${TMPDIR:-/tmp}/leash-m6-headed"
rm -rf "$WORK"
mkdir -p "$WORK"
chmod 700 "$WORK"
LOG="$WORK/transcript.txt"
BODY="$WORK/result-body.txt"
: >"$LOG"
: >"$BODY"
start_epoch="$(date +%s)"
start_stamp="$(date '+%Y-%m-%d %H:%M:%S')"
run_result="aborted"
results_written=0
server_pid=""
handoff_pid=""
finished=0

say() { printf '%s\n' "$*"; printf '%s\n' "$*" >>"$LOG"; }
section() {
  printf '\n=== %s ===\n' "$*"
  printf '\n=== %s ===\n' "$*" >>"$LOG"
  printf '\n## %s\n' "$*" >>"$BODY"
}
record() { printf '%s\n' "$*" >>"$BODY"; }
show() {
  local label="$1" text="$2" max="${3:-30}"
  {
    printf '%s\n' "--- $label ---"
    printf '%s\n' "$text" | awk -v n="$max" 'NR <= n'
  } | tee -a "$LOG"
}
quote_arg() {
  case "$1" in
    *" "*|*"'"*|*'"'*) printf '%q' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}
quote_cmd() {
  local out="" arg
  for arg in "$@"; do out+=" $(quote_arg "$arg")"; done
  printf '%s' "${out# }"
}
fatal() {
  say "ERROR: $*"
  record "fatal: $*"
  say "(nothing else was touched; the result file is written anyway)"
  exit 1
}
abort_run() {
  say "aborted: $*"
  record "aborted: $*"
  exit 2
}

# ---------------------------------------------------------------- dry-run fixtures
# In --dry-run every executed command is printed and its answer comes from here, so the
# whole flow, the parsing and the result files are exercised without touching anything.
fixture() {
  case "$1" in
    unit_file) cat <<'EOF'
[Unit]
After=graphical-session.target
Description=Leash browser service for coding agents
PartOf=graphical-session.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Environment=XDG_RUNTIME_DIR=%t
Environment=EIO_BACKEND=posix
ExecStart=/nix/store/00000000000000000000000000000000-leash-dev/bin/leash serve
Restart=on-failure
RestartSec=2
SuccessExitStatus=0

[Install]
WantedBy=graphical-session.target
EOF
      ;;
    unit_active) echo "active" ;;
    unit_show) printf 'ActiveState=active\nSubState=running\nExecMainStatus=0\nResult=success\nNRestarts=0\n' ;;
    unit_show_after_stop) printf 'ActiveState=inactive\nSubState=dead\nExecMainStatus=0\nResult=success\nNRestarts=1\n' ;;
    status) echo '{"generation":3,"tabs":{"open":1,"cap":32},"chrome":"running","uptime_s":42,"models":{"configured":false,"jev_model":"typesafe/jev-1.13-20260917","text_model":"inception/mercury-2.5","systemone_endpoint":"https://openrouter.ai/api/v1/chat/completions","chat_base_url":"https://openrouter.ai/api/v1"}}' ;;
    status_after_restart) echo '{"generation":4,"tabs":{"open":0,"cap":32},"chrome":"running","uptime_s":1,"models":{"configured":false,"jev_model":"typesafe/jev-1.13-20260917","text_model":"inception/mercury-2.5","systemone_endpoint":"https://openrouter.ai/api/v1/chat/completions","chat_base_url":"https://openrouter.ai/api/v1"}}' ;;
    niri_windows) echo '[{"id":7,"title":"Leash M6 acceptance page","app_id":"leash","workspace_id":2,"is_focused":false,"is_floating":false,"is_urgent":false},{"id":3,"title":"foot","app_id":"foot","workspace_id":1,"is_focused":true}]' ;;
    niri_windows_after) echo '[{"id":7,"title":"Leash M6 acceptance page","app_id":"leash","workspace_id":2,"is_focused":true,"is_floating":false,"is_urgent":false},{"id":3,"title":"foot","app_id":"foot","workspace_id":1,"is_focused":false}]' ;;
    niri_windows_after_restart) echo '[{"id":12,"title":"Leash M6 acceptance page","app_id":"leash","workspace_id":2,"is_focused":false,"is_floating":false,"is_urgent":false}]' ;;
    niri_workspaces) echo '[{"id":1,"idx":1,"name":"main","output":"eDP-1","is_active":true,"is_focused":true,"active_window_id":3},{"id":2,"idx":2,"name":"leash","output":"eDP-1","is_active":false,"is_focused":false,"active_window_id":7}]' ;;
    new) echo '{"tab":"t_fixture","url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","origin":"agent","state":"owned","generation":3,"expires":null}' ;;
    snap_input) echo '{"snapshot":"s_0001","tab":"t_fixture","url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","rows":[{"index":1,"role":"statictext","name":"Name"},{"index":2,"role":"textbox","name":"Name"},{"index":3,"role":"button","name":"Save"}],"total":3,"offset":0,"truncated":false,"settled":true,"dialog":null}' ;;
    snap_button) echo '{"snapshot":"s_0002","tab":"t_fixture","url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","rows":[{"index":2,"role":"textbox","name":"Name"},{"index":3,"role":"button","name":"Save"}],"total":2,"offset":0,"truncated":false,"settled":true,"dialog":null}' ;;
    fill) echo '{"tab":"t_fixture","url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","snapshot":null,"dialog":null,"popups":[]}' ;;
    click) echo '{"tab":"t_fixture","url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","snapshot":null,"dialog":null,"popups":[]}' ;;
    text) echo '{"url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","text":"Leash acceptance page\nName\nSave\nHello Leash operator!","truncated":false}' ;;
    text_after_restart) echo '{"code":"unknown-tab","message":"no tab and no tombstone for t_fixture"}' ;;
    status_after_stop) echo "connect: No such file or directory" ;;
    shot) echo '{"path":"/tmp/leash-m6-headed/workflow.png","bytes":23456}' ;;
    debug) echo '{"entries":[]}' ;;
    close) echo '{"closed":true}' ;;
    list_all) echo '{"tabs":[{"tab":"t_fixture","url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page","origin":"agent","state":"owned","generation":3,"expires":null}]}' ;;
    list_all_empty) echo '{"tabs":[]}' ;;
    handoff) echo '{"resumed":true,"url":"http://127.0.0.1:8080/","title":"Leash M6 acceptance page"}' ;;
    journal_tail) printf '{"ts":"2026-01-01T00:00:00Z","level":"info","service":"leash","msg":"control command","context":{"tab":"-","cmd":"status"}}\n{"ts":"2026-01-01T00:00:01Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"close"}}\n' ;;
    journal_run) printf '{"ts":"2026-01-01T00:00:00Z","level":"info","service":"leash","msg":"control command","context":{"tab":"-","cmd":"status"}}\n{"ts":"2026-01-01T00:00:01Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"new"}}\n{"ts":"2026-01-01T00:00:02Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"snap"}}\n{"ts":"2026-01-01T00:00:03Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"fill"}}\n{"ts":"2026-01-01T00:00:04Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"click"}}\n{"ts":"2026-01-01T00:00:05Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"text"}}\n{"ts":"2026-01-01T00:00:06Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"shot"}}\n{"ts":"2026-01-01T00:00:07Z","level":"info","service":"leash","msg":"control command","context":{"tab":"t_fixture","cmd":"close"}}\n' ;;
    profile) echo "exists=yes files=137 bytes=9876543 cookies=yes login_data=yes" ;;
    chrome_procs) echo "2" ;;
    *) : ;;
  esac
}

fixture_text() { # fixture_text KEY -> the fixture for KEY
  fixture "${1#fail:}"
}

# ---------------------------------------------------------------------- run helpers
try() { # try VAR FIXTURE cmd... -> VAR gets combined stdout+stderr; returns the exit code
  local __var="$1" __fixture="$2"
  shift 2
  local canned=""
  say "  \$ $(quote_cmd "$@")"
  if (( dry )); then
    canned="$(fixture_text "$__fixture")"
    printf '%s\n' "$canned" >>"$LOG"
    printf -v "$__var" '%s' "$canned"
    case "$__fixture" in fail:*) return 1 ;; *) return 0 ;; esac
  fi
  local out status
  if out="$("$@" 2>&1)"; then status=0; else status=$?; fi
  printf '%s\n' "$out" >>"$LOG"
  printf -v "$__var" '%s' "$out"
  return "$status"
}

run() { # run FIXTURE cmd... -> for effect; the fixture is used only by --dry-run
  local __fixture="$1"
  shift
  say "  \$ $(quote_cmd "$@")"
  if (( dry )); then
    local canned
    canned="$(fixture_text "$__fixture")"
    if [[ -n "$canned" ]]; then say "$canned"; fi
    return 0
  fi
  "$@"
}

capture_file() { # capture_file FILE FIXTURE cmd... -> writes combined output to FILE
  local __file="$1" __fixture="$2"
  shift 2
  say "  \$ $(quote_cmd "$@") > $__file"
  if (( dry )); then
    fixture_text "$__fixture" >"$__file" 2>/dev/null || true
    case "$__fixture" in fail:*) return 1 ;; *) return 0 ;; esac
  fi
  "$@" >"$__file" 2>&1
}

ask() { # ask VAR "question" [default] -> --dry-run and --yes use the default
  local __var="$1" question="$2" default="${3:-}"
  if (( dry )); then
    say "  ? $question [${default:-<dry-run>}] (dry-run: not asked)"
    printf -v "$__var" '%s' "$default"
    return 0
  fi
  if (( assume_yes )); then
    say "  ? $question [${default:-}] (--yes)"
    printf -v "$__var" '%s' "$default"
    return 0
  fi
  local answer=""
  say "  ? $question"
  if ! read -r -p "    > " answer; then
    say "  ! input closed"
    abort_run "no answer to: $question"
  fi
  printf -v "$__var" '%s' "${answer:-$default}"
}

ask_yn() { # ask_yn VAR "question" [default]
  local __var="$1" question="$2" default="${3:-n}" answer="" hint="y/N"
  if [[ "$default" == y ]]; then hint="Y/n"; fi
  ask answer "$question [$hint]" "$default"
  case "$answer" in
    y|Y|yes|YES|Yes) printf -v "$__var" '%s' "y" ;;
    n|N|no|NO|No) printf -v "$__var" '%s' "n" ;;
    *) printf -v "$__var" '%s' "$default" ;;
  esac
}

pyq() { # pyq FILE EXPR -> value of the python expression EXPR over the JSON in FILE
  python3 - "$1" "$2" <<'PY'
import json, sys
path, expr = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    print("(no reply)")
    raise SystemExit(0)
try:
    value = eval(expr, {"d": d, "json": json})
except Exception as exc:
    print("(no field: %s)" % exc)
    raise SystemExit(0)
if value is None:
    print("null")
elif isinstance(value, bool):
    print("true" if value else "false")
elif isinstance(value, (dict, list)):
    print(json.dumps(value, sort_keys=True))
else:
    print(value)
PY
}

niri_summary() { # niri_summary WINDOWS_JSON [WORKSPACES_JSON]
  python3 - "$1" "${2:-}" <<'PY'
import json, sys


def load(path):
    if not path:
        return []
    try:
        data = json.load(open(path))
    except Exception:
        return []
    if isinstance(data, dict):
        return data.get("windows") or data.get("workspaces") or []
    return data


windows = load(sys.argv[1])
names = {str(w.get("id")): w.get("name") for w in load(sys.argv[2])}
keys = ("id", "app_id", "title", "workspace_id", "is_focused", "is_floating", "is_urgent", "is_active", "visible")
matched = []
for w in windows:
    if not isinstance(w, dict):
        continue
    if str(w.get("app_id") or "") == "leash" or "leash" in str(w.get("title") or "").lower():
        row = {k: w[k] for k in keys if k in w}
        workspace = names.get(str(w.get("workspace_id")))
        if workspace is not None:
            row["workspace_name"] = workspace
        matched.append(row)
if matched:
    for row in matched:
        print(json.dumps(row, sort_keys=True))
else:
    app_ids = sorted({str(w.get("app_id")) for w in windows if isinstance(w, dict)})
    print('(no window with app_id "leash"; app_ids on screen: %s)' % (", ".join(app_ids) or "none"))
PY
}

snap_pick() { # snap_pick FILE input|button -> "SNAPSHOT<TAB>INDEX<TAB>ROLE<TAB>NAME"
  python3 - "$1" "$2" <<'PY'
import json, sys
path, want = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    raise SystemExit(0)
rows = [r for r in (d.get("rows") or []) if isinstance(r, dict)]
roles = {"input": {"textbox", "searchbox"}, "button": {"button"}}[want]
candidates = [r for r in rows if str(r.get("role") or "") in roles]
if want == "input":
    named = [r for r in candidates if "name" in str(r.get("name") or "").lower()]
    candidates = named or candidates or [r for r in rows if str(r.get("role") or "") in ("text field", "input")]
if not candidates:
    raise SystemExit(0)
row = candidates[0]
print("%s\t%s\t%s\t%s" % (d.get("snapshot", ""), row.get("index", ""), row.get("role", ""), row.get("name", "")))
PY
}

journal_command_cmds() { # journal_command_cmds FILE -> "RECORDS<TAB>CMD,CMD"
  python3 - "$1" <<'PY'
import json, sys
path = sys.argv[1]
cmds, matched = [], 0
try:
    lines = open(path, errors="replace").read().splitlines()
except Exception:
    lines = []
for line in lines:
    start = line.find("{")
    if start < 0:
        continue
    try:
        record = json.loads(line[start:])
    except Exception:
        continue
    context = record.get("context") or {}
    if context.get("cmd"):
        matched += 1
        cmd = context.get("cmd")
        if cmd and cmd not in cmds:
            cmds.append(cmd)
print("%d\t%s" % (matched, ",".join(cmds) or "-"))
PY
}

profile_stats() { # profile_stats DIR
  python3 - "$1" <<'PY'
import os, sys
path = sys.argv[1]
if not os.path.isdir(path):
    print("exists=no")
    raise SystemExit(0)
files = 0
size = 0
for root, _dirs, names in os.walk(path):
    for name in names:
        files += 1
        try:
            size += os.path.getsize(os.path.join(root, name))
        except OSError:
            pass
print("exists=yes files=%d bytes=%d cookies=%s login_data=%s" % (
    files, size,
    "yes" if os.path.exists(os.path.join(path, "Default", "Cookies")) else "no",
    "yes" if os.path.exists(os.path.join(path, "Default", "Login Data")) else "no"))
PY
}

chrome_processes() { # chrome_processes PROFILE_DIR -> number of managed Chrome processes
  python3 - "$1" <<'PY'
import os, sys
needle = ("--user-data-dir=" + sys.argv[1]).encode()
count = 0
for entry in os.listdir("/proc"):
    if not entry.isdigit():
        continue
    try:
        argv = open("/proc/" + entry + "/cmdline", "rb").read().split(b"\0")
    except OSError:
        continue
    if any(needle in arg for arg in argv) and any(b"--remote-debugging-pipe" in arg for arg in argv):
        count += 1
print(count)
PY
}

write_results() {
  if (( results_written )); then return 0; fi
  results_written=1
  local stamp mode
  stamp="$(date -u +%FT%TZ)"
  if (( dry )); then
    mode="dry-run (canned fixtures; nothing below touched systemd, Chrome, the control socket or the network)"
  else
    mode="headed (operator-run, real unit, real Chrome, real desktop)"
  fi
  {
    echo "=== Leash milestone-6 headed acceptance (L28, carries L18) ==="
    echo "mode: $mode"
    echo "written: $stamp"
    echo "started: $start_stamp"
    cat "$BODY"
    echo
    echo "artifacts (in $WORK):"
    ls -1 "$WORK" 2>/dev/null | awk '{print "  " $0}'
    echo
    echo "L18's own result file: $m4_result_file"
    echo
    echo "Paste this whole block back to the agent."
  } >"$result_file" 2>/dev/null || true
  {
    echo "result: $run_result"
    echo "date: $stamp"
    echo "mode: $mode"
    echo "produced_by: scripts/live-acceptance-m6-headed (L28 headed run, L18 folded in)"
    echo "reason: ${handoff_reason:-(not reached)}"
    echo "tab_resumed: ${handoff_resumed:-unknown}"
    echo "resumed_via: ${resumed_via:-unknown}"
    echo "handoff_reply: ${handoff_reply:-(not reached)}"
    echo "user_saw_focus: ${q_focus:-unknown}"
    echo "user_focus_note: ${q_focus_note:-(none)}"
    echo "user_saw_notification_with_done: ${q_notify:-unknown}"
    echo "user_notification_note: ${q_notify_note:-(none)}"
    echo "user_resume_note: ${q_resume_note:-(none)}"
    echo "service_stop: ${service_stop_summary:-(not reached)}"
    echo "--- niri windows (app_id leash) BEFORE the handoff ---"
    cat "$WORK/m4-niri-before.txt" 2>/dev/null || echo "(not recorded)"
    echo "--- niri windows (app_id leash) AFTER the handoff started ---"
    cat "$WORK/m4-niri-after.txt" 2>/dev/null || echo "(not recorded)"
    echo "--- full niri dumps: see $WORK (temp) ---"
  } >"$m4_result_file" 2>/dev/null || true
}

finalize() {
  local code=$?
  trap - EXIT
  if [[ -n "$handoff_pid" ]] && kill -0 "$handoff_pid" 2>/dev/null; then
    kill -TERM "$handoff_pid" 2>/dev/null || true
    wait "$handoff_pid" 2>/dev/null || true
  fi
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill -TERM "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  if (( finished == 0 )) && (( results_written == 0 )); then
    record "result: aborted before the end (exit $code)"
  fi
  write_results
  exit "$code"
}
trap finalize EXIT

# --------------------------------------------------------------------------- start
printf '\n'
say "=== Leash milestone-6 headed acceptance (L28 + L18) ==="
say "This is the one run a human must witness: it drives the installed leash.service,"
say "opens one headed Chrome window on your desktop, and sends one real notification."
say "Your existing windows are otherwise untouched. The script never installs anything"
say "and never starts Chrome by itself; the unit's service does."
if (( dry )); then
  say ""
  say "*** DRY RUN: nothing will be started, restarted, stopped or opened. ***"
  say "*** Every command below is printed; answers and measurements come from     ***"
  say "*** canned fixtures so the result files can be checked end to end.         ***"
fi
say ""
say "Result files: $result_file"
say "              $m4_result_file  (L18's fields)"
say "Artifacts:    $WORK"
say ""

section "0. environment"
commit="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo unknown)"
record "date: $(date -u +%FT%TZ)"
record "host: $(hostname 2>/dev/null || echo unknown)"
record "user: ${USER:-unknown}"
record "repo: $repo"
record "commit: $commit"
record "handoff_timeout_s: $handoff_timeout_s"
have_niri=""
if command -v niri >/dev/null 2>&1; then have_niri=1; fi
have_notify=""
if command -v notify-send >/dev/null 2>&1; then have_notify=1; fi
if (( dry )); then
  have_niri=1
  have_notify=1
  say "(dry run: treating niri and notify-send as present so their steps are exercised)"
fi
record "niri_on_path: $([[ -n "$have_niri" ]] && echo yes || echo no)"
record "notify_send_on_path: $([[ -n "$have_notify" ]] && echo yes || echo no)"
say "commit $commit; niri: $([[ -n "$have_niri" ]] && echo yes || echo no); notify-send: $([[ -n "$have_notify" ]] && echo yes || echo no)"

# ------------------------------------------------------------------------ 1. install
section "1. install the unit (docs/install.md) — printed here, installed by you"
cat <<'EOF'
Build (the unit's ExecStart names this package's binary):

  nix build .#leash --print-out-paths --no-link            # ...-leash-dev
  unit="$(nix build .#leash-unit --print-out-paths --no-link)/leash.service"
  cat "$unit"

Option A — home-manager (this machine; docs/install.md "Install with home-manager"):

  # /home/ribelo/nixos-config/flake.nix, among the inputs
  inputs.leash.url = "path:/home/ribelo/projects/ribelo/leash";

  # /home/ribelo/nixos-config/home/common/desktop/shell-stack.nix, beside the pie entry
  imports = [ inputs.leash.homeManagerModules.leash ];
  ribelo.leash.enable = true;

  sudo nixos-rebuild switch --flake /home/ribelo/nixos-config#desktop
  systemctl --user status leash.service
  # WantedBy=graphical-session.target starts it with the next session; for this one:
  systemctl --user start leash.service

Option B — hand install (no home-manager; docs/install.md "Install by hand"):

  unit="$(nix build .#leash-unit --print-out-paths --no-link)/leash.service"
  install -Dm644 "$unit" ~/.config/systemd/user/leash.service
  systemctl --user daemon-reload
  systemctl --user enable --now leash.service

The niri window rule (add by hand; Leash never edits your niri config) — in
~/.config/niri/config.kdl, beside the other window-rule blocks:

  window-rule {
      match app-id="^leash$"
      open-on-workspace "leash"
      open-focused false
  }

niri live-reloads config.kdl when the file changes; the rule puts the browser on the
"leash" workspace (created on demand) and keeps it from stealing focus.
EOF
record "install_printed: yes (docs/install.md build + home-manager + hand install + niri rule)"
ask install_path "Which install did you use? [home-manager|hand|already]" "already"
record "install_path: $install_path"
ask_yn install_confirmed "Is leash.service installed, enabled, and started (or start it now)?" y
if [[ "$install_confirmed" != y ]]; then
  fatal "the unit has to be installed before this acceptance means anything; see docs/install.md"
fi

# -------------------------------------------------------------------- 2. unit, CLI
section "2. the unit and its CLI"
capture_file "$WORK/unit-file.txt" unit_file systemctl --user cat leash.service ||
  fatal "systemctl --user cat leash.service failed; is the unit installed? (docs/install.md)"
record "unit_file: $WORK/unit-file.txt"
if [[ -n "$leash_override" ]]; then
  LEASH="$leash_override"
  leash_bin_source="--leash option"
else
  exec_line="$(sed -n 's/^ExecStart=//p' "$WORK/unit-file.txt" | head -n 1)"
  unit_bin="${exec_line% run}"
  if [[ -n "$unit_bin" && ( -x "$unit_bin" || "$dry" == 1 ) ]]; then
    LEASH="$unit_bin"
    leash_bin_source="unit ExecStart"
  elif command -v leash >/dev/null 2>&1; then
    LEASH="$(command -v leash)"
    leash_bin_source="PATH"
  elif [[ -x "$repo/_build/default/packages/leash/bin/main.exe" ]]; then
    LEASH="$repo/_build/default/packages/leash/bin/main.exe"
    leash_bin_source="dune build (workspace HEAD)"
  elif command -v nix >/dev/null 2>&1; then
    say "no leash CLI found; building .#leash once…"
    LEASH="$(nix build "$repo#leash" --print-out-paths --no-link 2>/dev/null)/bin/leash"
    leash_bin_source="nix build .#leash"
  else
    fatal "no leash CLI: no ExecStart in the unit, none on PATH, no dune build, no nix"
  fi
fi
if [[ ! -x "$LEASH" ]] && (( dry == 0 )); then
  fatal "the leash CLI is not executable: $LEASH"
fi
record "leash_bin: $LEASH"
record "leash_bin_source: $leash_bin_source"
say "leash CLI: $LEASH ($leash_bin_source)"

record "capability: handle from leash new; list never prints it"
say "capability: the handle from leash new; list never prints it."

if ! capture_file "$WORK/unit-before.txt" unit_show systemctl --user show leash.service -p ActiveState,SubState,ExecMainStatus,Result,NRestarts; then
  fatal "systemctl --user show leash.service failed"
fi
show "systemctl --user show leash.service" "$(cat "$WORK/unit-before.txt")" 10
unit_active_before="$(sed -n 's/^ActiveState=//p' "$WORK/unit-before.txt" | head -n 1)"
record "unit_active_before: ${unit_active_before:-unknown}"
if [[ "$unit_active_before" != "active" ]]; then
  ask_yn start_now "leash.service is not active — start it now (systemctl --user start leash.service)?" y
  if [[ "$start_now" == y ]]; then
    run "" systemctl --user start leash.service
    sleep 1
    capture_file "$WORK/unit-before.txt" unit_show systemctl --user show leash.service -p ActiveState,SubState,ExecMainStatus,Result,NRestarts || true
    unit_active_before="$(sed -n 's/^ActiveState=//p' "$WORK/unit-before.txt" | head -n 1)"
    record "unit_active_after_start: ${unit_active_before:-unknown}"
    if [[ "$unit_active_before" != "active" ]]; then
      capture_file "$WORK/journal-failed-start.txt" journal_tail journalctl --user -u leash.service -n 30 --no-pager || true
      show "journalctl --user -u leash.service -n 30" "$(cat "$WORK/journal-failed-start.txt" 2>/dev/null)" 30
      fatal "the unit did not become active; see the journal above"
    fi
  else
    fatal "the unit must be running for this acceptance"
  fi
fi
say "unit is active."

status_rc=0
capture_file "$WORK/status-1.json" status "$LEASH" status || status_rc=$?
record "leash_status_exit: $status_rc"
show "leash status" "$(cat "$WORK/status-1.json" 2>/dev/null)" 10
if (( status_rc != 0 )); then
  fatal "leash status failed while the unit is active; see docs/install.md (health check and logs)"
fi
record "status_chrome: $(pyq "$WORK/status-1.json" 'd["chrome"]')"
record "status_generation: $(pyq "$WORK/status-1.json" 'd["generation"]')"
record "status_tabs_open: $(pyq "$WORK/status-1.json" 'd["tabs"]["open"]')"
record "status_models_configured: $(pyq "$WORK/status-1.json" 'd["models"]["configured"]')"
generation_before="$(pyq "$WORK/status-1.json" 'd["generation"]')"
say "leash status: healthy (chrome $(pyq "$WORK/status-1.json" 'd["chrome"]'), generation $generation_before)"
if [[ "$(pyq "$WORK/status-1.json" 'd["models"]["configured"]')" != "true" ]]; then
  say "note: models.configured is false — drive would refuse; that is out of scope for L28."
  record "models_note: no API key configured; drive is out of scope for L28"
fi

# ----------------------------------------------------------------- 3. niri baseline
section "3. niri placement baseline (app-id leash)"
niri_config="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
if [[ -L "$niri_config" ]]; then
  record "niri_config_symlink: $niri_config -> $(readlink "$niri_config")"
  say "note: $niri_config is a symlink (home-manager?); edit the file it points at and rebuild."
fi
rule_line=""
if [[ -f "$niri_config" ]]; then
  rule_line="$(awk '/app-id/ && /leash/ { print NR; exit }' "$niri_config" 2>/dev/null || true)"
fi
if [[ -n "$rule_line" ]]; then
  rule_block="$(sed -n "${rule_line},$(( rule_line + 6 ))p" "$niri_config" 2>/dev/null || true)"
  rule_workspace="NOT set in the rule block"
  case "$rule_block" in *open-on-workspace*) rule_workspace="open-on-workspace set" ;; esac
  rule_focused="NOT set in the rule block"
  case "$rule_block" in *"open-focused false"*) rule_focused="open-focused false" ;; esac
  record "niri_rule_present: yes (line $rule_line of $niri_config)"
  record "niri_rule_workspace: $rule_workspace"
  record "niri_rule_open_focused: $rule_focused"
  say "niri rule present at $niri_config:$rule_line"
else
  record "niri_rule_present: no (checked $niri_config)"
  say "WARNING: no window-rule matching app-id leash was found in $niri_config;"
  say "         the window will land wherever niri puts it. docs/install.md has the block."
fi
if [[ -z "$have_niri" ]]; then
  record "niri: not on PATH; placement unverifiable"
  say "niri is not on PATH: placement will not be recorded."
else
  capture_file "$WORK/niri-windows-before.json" niri_windows niri msg --json windows || true
  capture_file "$WORK/niri-workspaces-before.json" niri_workspaces niri msg --json workspaces || true
  niri_summary "$WORK/niri-windows-before.json" "$WORK/niri-workspaces-before.json" >"$WORK/summary-niri-before.txt"
  show "niri windows (app-id leash) before anything" "$(cat "$WORK/summary-niri-before.txt")" 6
  record "niri_before: $(tr '\n' ' ' <"$WORK/summary-niri-before.txt")"
fi

# -------------------------------------------------------------- 4. skill workflow
section "4. the L27 leash-skill workflow, from your shell, by handle"
say "This serves a local page on 127.0.0.1 and drives it through the skill's commands:"
say "new, snap --match, fill, click, text, shot, debug, close."
site_dir="$WORK/site"
mkdir -p "$site_dir"
cat >"$site_dir/index.html" <<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Leash M6 acceptance page</title>
</head>
<body>
<h1>Leash acceptance page</h1>
<p>This page is served by scripts/live-acceptance-m6-headed on 127.0.0.1.</p>
<label for="name">Name</label>
<input id="name" name="name" type="text" placeholder="Your name">
<button id="save" type="button">Save</button>
<p id="result">not saved yet</p>
<script>
document.getElementById("save").addEventListener("click", function () {
  document.getElementById("result").textContent = "Hello " + document.getElementById("name").value + "!";
});
</script>
</body>
</html>
HTML
workflow_port=""
if (( dry )); then
  say "  \$ python3 (local page server on 127.0.0.1, ephemeral port) (dry-run: not started)"
  workflow_port="8080"
else
  port_file="$WORK/port"
  python3 - "$site_dir" "$port_file" <<'PY' >>"$WORK/page-server.log" 2>&1 &
import functools, http.server, socketserver, sys

site, port_file = sys.argv[1], sys.argv[2]
handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=site)


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


server = Server(("127.0.0.1", 0), handler)
with open(port_file, "w") as out:
    out.write(str(server.server_address[1]))
server.serve_forever()
PY
  server_pid=$!
  for _ in $(seq 1 100); do
    if [[ -s "$port_file" ]]; then break; fi
    sleep 0.05
  done
  if [[ ! -s "$port_file" ]]; then
    fatal "the local acceptance page server did not start (see $WORK/page-server.log)"
  fi
  workflow_port="$(cat "$port_file")"
fi
page_url="http://127.0.0.1:$workflow_port/"
record "workflow_page: $page_url"
say "page: $page_url"

tab=""
if capture_file "$WORK/new.json" new "$LEASH" new "$page_url"; then
  tab="$(pyq "$WORK/new.json" 'd["tab"]')"
  record "workflow_new: $(tr -d '\n' <"$WORK/new.json")"
  record "workflow_tab: $tab"
  show "leash new (tab $tab)" "$(cat "$WORK/new.json")" 6
else
  fatal "leash new failed; see $(cat "$WORK/new.json" 2>/dev/null)"
fi

capture_file "$WORK/list-all-1.json" list_all "$LEASH" list || true
record "workflow_list_all: $(tr -d '\n' <"$WORK/list-all-1.json")"
capture_file "$WORK/snap-input.json" snap_input "$LEASH" snap "$tab" --match 'Name' --limit 10 --pretty || true
show "snap --match Name" "$(cat "$WORK/snap-input.json")" 25
fill_row="$(snap_pick "$WORK/snap-input.json" input)"
if [[ -z "$fill_row" ]]; then
  say "no textbox matched \"Name\"; taking an unfiltered snapshot"
  record "workflow_snap_fallback: input (no row matched 'Name')"
  capture_file "$WORK/snap-input.json" snap_input "$LEASH" snap "$tab" --limit 20 --pretty || true
  show "snap --limit 20 (fallback)" "$(cat "$WORK/snap-input.json")" 25
  fill_row="$(snap_pick "$WORK/snap-input.json" input)"
fi
if [[ -z "$fill_row" ]]; then
  fatal "no textbox row in the snapshot; inspect $WORK/snap-input.json"
fi
IFS=$'\t' read -r fill_snapshot fill_index fill_role fill_name <<<"$fill_row"
record "workflow_fill_row: snapshot=$fill_snapshot index=$fill_index role=$fill_role name=$fill_name"
say "textbox: index $fill_index ($fill_role \"$fill_name\") of snapshot $fill_snapshot"

if capture_file "$WORK/fill.json" fill "$LEASH" fill "$tab" "$fill_snapshot" "$fill_index" 'Leash operator'; then
  record "workflow_fill: ok"
else
  fatal "leash fill failed: $(cat "$WORK/fill.json" 2>/dev/null)"
fi

capture_file "$WORK/snap-button.json" snap_button "$LEASH" snap "$tab" --match 'Save' --limit 10 --pretty || true
show "snap --match Save" "$(cat "$WORK/snap-button.json")" 25
click_row="$(snap_pick "$WORK/snap-button.json" button)"
if [[ -z "$click_row" ]]; then
  say "no button matched \"Save\"; taking an unfiltered snapshot"
  record "workflow_snap_fallback: button (no row matched 'Save')"
  capture_file "$WORK/snap-button.json" snap_button "$LEASH" snap "$tab" --limit 20 --pretty || true
  show "snap --limit 20 (fallback)" "$(cat "$WORK/snap-button.json")" 25
  click_row="$(snap_pick "$WORK/snap-button.json" button)"
fi
if [[ -z "$click_row" ]]; then
  fatal "no button row in the snapshot; inspect $WORK/snap-button.json"
fi
IFS=$'\t' read -r click_snapshot click_index click_role click_name <<<"$click_row"
record "workflow_click_row: snapshot=$click_snapshot index=$click_index role=$click_role name=$click_name"

if capture_file "$WORK/click.json" click "$LEASH" click "$tab" "$click_snapshot" "$click_index"; then
  record "workflow_click: ok"
else
  fatal "leash click failed: $(cat "$WORK/click.json" 2>/dev/null)"
fi

capture_file "$WORK/text.json" text "$LEASH" text "$tab" --max-chars 300 || true
workflow_text="$(pyq "$WORK/text.json" 'd["text"]')"
record "workflow_text: $(printf '%s' "$workflow_text" | tr '\n' ' ' | cut -c1-200)"
if [[ "$workflow_text" == *"Hello Leash operator!"* ]]; then
  record "workflow_text_ok: yes (the click changed the page: \"Hello Leash operator!\")"
  say "page text shows the click worked: \"Hello Leash operator!\""
else
  record "workflow_text_ok: no"
  show "leash text" "$(cat "$WORK/text.json")" 10
  say "WARNING: the page text does not contain \"Hello Leash operator!\" — record this."
fi

if capture_file "$WORK/shot.json" shot "$LEASH" shot "$tab" "$WORK/workflow.png"; then
  shot_bytes="$(pyq "$WORK/shot.json" 'd["bytes"]')"
  record "workflow_shot: $WORK/workflow.png bytes=$shot_bytes"
  if (( dry == 0 )) && [[ -f "$WORK/workflow.png" ]]; then
    record "workflow_shot_file: $(file -b "$WORK/workflow.png" 2>/dev/null || echo '(file(1) unavailable)')"
  fi
  say "screenshot written: $WORK/workflow.png ($shot_bytes bytes)"
else
  record "workflow_shot: failed"
  say "WARNING: leash shot failed (could the the service write $WORK/workflow.png?)"
fi

capture_file "$WORK/debug.json" debug "$LEASH" debug "$tab" --limit 10 || true
record "workflow_debug_entries: $(pyq "$WORK/debug.json" 'len(d.get("entries") or [])')"

if capture_file "$WORK/close.json" close "$LEASH" close "$tab"; then
  record "workflow_close: ok"
else
  record "workflow_close: failed"
fi
capture_file "$WORK/list-all-2.json" list_all_empty "$LEASH" list || true
record "tabs_after_workflow_close: $(pyq "$WORK/list-all-2.json" 'len(d.get("tabs") or [])') (list; human-origin tabs included)"
say "workflow done; the tab is closed."

capture_file "$WORK/journal-run.json" journal_run journalctl --user -u leash.service --since "$start_stamp" --no-pager || true
journal_command="$(journal_command_cmds "$WORK/journal-run.json")"
IFS=$'\t' read -r journal_command_records journal_command_cmd_list <<<"$journal_command"
record "journal_command_records: $journal_command_records"
record "journal_command_cmds: $journal_command_cmd_list"
say "journal: $journal_command_records record(s), cmds: $journal_command_cmd_list"

# ---------------------------------------------------------------- 5. handoff (L18)
section "5. one handoff (L18: focus, notification, Done)"
say "A handoff hands the tab to you: the service calls Target.activateTarget, runs its"
say "niri focus command, and shows a notify-send notification whose Done action resumes."
say ""
handoff_reason="L18/L28 headed acceptance: press Done in this notification"
if capture_file "$WORK/handoff-tab.json" new "$LEASH" new "$page_url"; then
  handoff_tab="$(pyq "$WORK/handoff-tab.json" 'd["tab"]')"
  record "handoff_tab: $handoff_tab"
else
  fatal "could not open the handoff tab"
fi
if [[ -n "$have_niri" ]]; then
  capture_file "$WORK/niri-windows-handoff-before.json" niri_windows niri msg --json windows || true
  capture_file "$WORK/niri-workspaces-handoff-before.json" niri_workspaces niri msg --json workspaces || true
  niri_summary "$WORK/niri-windows-handoff-before.json" "$WORK/niri-workspaces-handoff-before.json" >"$WORK/m4-niri-before.txt"
  record "handoff_niri_before: $(tr '\n' ' ' <"$WORK/m4-niri-before.txt")"
fi
handoff_out="$WORK/handoff-reply.txt"
: >"$handoff_out"
handoff_started_epoch="$(date +%s)"
say "  \$ $(quote_cmd "$LEASH" handoff "$handoff_tab" "$handoff_reason" --timeout-s "$handoff_timeout_s") > $handoff_out &"
if (( dry )); then
  fixture_text handoff >"$handoff_out"
else
  say "    (running now, up to ${handoff_timeout_s}s; watch your desktop)"
  (
    "$LEASH" handoff "$handoff_tab" "$handoff_reason" --timeout-s "$handoff_timeout_s" \
      >"$handoff_out" 2>&1
  ) &
  handoff_pid=$!
  sleep 3
fi
if [[ -n "$have_niri" ]]; then
  capture_file "$WORK/niri-windows-handoff-after.json" niri_windows_after niri msg --json windows || true
  capture_file "$WORK/niri-workspaces-handoff-after.json" niri_workspaces niri msg --json workspaces || true
  niri_summary "$WORK/niri-windows-handoff-after.json" "$WORK/niri-workspaces-handoff-after.json" >"$WORK/m4-niri-after.txt"
  show "niri windows (app-id leash) right after the handoff started" "$(cat "$WORK/m4-niri-after.txt")" 6
  record "handoff_niri_after: $(tr '\n' ' ' <"$WORK/m4-niri-after.txt")"
fi
say ""
say "  Q1: did the Chrome window come to the front (the tab that was just opened)?"
ask q_focus "Q1 did the window come to the front? [y/n]" "n"
ask q_focus_note "Q1 note (what happened instead, if anything):" "(none)"
record "user_saw_focus: $q_focus"
record "user_focus_note: $q_focus_note"
say ""
say "  Q2: a notification should show this reason with a Done button:"
say "        $handoff_reason"
ask q_notify "Q2 did the notification appear with the reason and a Done button? [y/n]" "n"
ask q_notify_note "Q2 note (text/button missing, daemon, etc.):" "(none)"
record "user_saw_notification_with_done: $q_notify"
record "user_notification_note: $q_notify_note"
say ""
say "  Now click Done in the notification. (CLI fallback, from another terminal:"
say "      $LEASH resume $handoff_tab"
say "  ) then come back here."
ask _ignored "Press ENTER here once you clicked Done (or resumed from the terminal):" ""

if (( dry == 0 )) && [[ -n "$handoff_pid" ]]; then
  if kill -0 "$handoff_pid" 2>/dev/null; then
    say "  (handoff still waiting — giving it 60 more seconds for the Done click…)"
    for _ in $(seq 1 60); do
      kill -0 "$handoff_pid" 2>/dev/null || break
      sleep 1
    done
  fi
  if kill -0 "$handoff_pid" 2>/dev/null; then
    say "  (still waiting; stopping the handoff client — the service clears with_human on disconnect)"
    kill -TERM "$handoff_pid" 2>/dev/null || true
    wait "$handoff_pid" 2>/dev/null || true
    record "handoff_client_stopped_by_script: yes"
  else
    wait "$handoff_pid" 2>/dev/null || true
  fi
  handoff_pid=""
fi
handoff_elapsed="$(( $(date +%s) - handoff_started_epoch ))"
record "handoff_elapsed_s: $handoff_elapsed"
handoff_reply="$(tr -d '\n' <"$handoff_out")"
record "handoff_reply: ${handoff_reply:-(no reply)}"
show "handoff reply" "${handoff_reply:-(no reply)}" 8
parsed="$(python3 - "$handoff_out" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("unknown\t(no reply)\t(none)")
    raise SystemExit(0)
resumed = "yes" if d.get("resumed") is True else "no"
code = d.get("code") or "(none)"
warnings = d.get("warnings") or (d.get("detail") or {}).get("warnings") or []
print("%s\t%s\t%s" % (resumed, code, "; ".join(str(w) for w in warnings) or "(none)"))
PY
)"
IFS=$'\t' read -r handoff_resumed handoff_code handoff_warnings <<<"$parsed"
record "handoff_resumed: $handoff_resumed"
record "handoff_code: $handoff_code"
record "handoff_warnings: $handoff_warnings"
ask resumed_via "How did the handoff end? [done-click|terminal-resume|timeout|other]" "done-click"
ask_yn q3_done "Q3 did clicking Done in the notification resume it?" y
ask q_resume_note "Q3 note:" "(none)"
record "resumed_via: $resumed_via"
record "user_done_click_resumed: $q3_done"
record "user_resume_note: $q_resume_note"
say "handoff: resumed=$handoff_resumed, warnings=$handoff_warnings"
if capture_file "$WORK/text-after-resume.json" text "$LEASH" text "$handoff_tab" --max-chars 200; then
  record "handoff_tab_after_resume: $(pyq "$WORK/text-after-resume.json" '(d.get("text") or "").replace(chr(10), " ")[:160]')"
  record "handoff_tab_reachable_after: yes"
else
  record "handoff_tab_reachable_after: no"
fi

# ------------------------------------------------------------------ 6. restart, stop
section "6. restart, tab loss, profile survival, stop, journal"
profile_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
if (( dry )); then
  say "  \$ systemctl --user show-environment | sed -n 's/^XDG_DATA_HOME=//p' (dry-run: not called)"
else
  service_data_home="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_DATA_HOME=//p' || true)"
  if [[ -n "$service_data_home" && "$service_data_home" != *'$'* ]]; then
    profile_data_home="$service_data_home"
  fi
fi
profile_dir="$profile_data_home/leash/profile"
record "profile_dir: $profile_dir"
if (( dry )); then
  profile_before="$(fixture_text profile)"
  chrome_before="$(fixture_text chrome_procs)"
else
  profile_before="$(profile_stats "$profile_dir")"
  chrome_before="$(chrome_processes "$profile_dir")"
fi
record "profile_before_restart: $profile_before"
record "chrome_processes_before_restart: $chrome_before"
capture_file "$WORK/list-before-restart.json" list_all "$LEASH" list || true
record "tabs_before_restart: $(pyq "$WORK/list-before-restart.json" 'len(d.get("tabs") or [])')"

say "restarting the unit: systemctl --user restart leash.service"
restart_rc=0
try sysctl_restart_reply "" systemctl --user restart leash.service || restart_rc=$?
record "restart_exit: $restart_rc"
health_after_restart="no"
for _ in $(seq 1 120); do
  if capture_file "$WORK/status-2.json" status_after_restart "$LEASH" status; then
    if [[ "$(pyq "$WORK/status-2.json" 'd["chrome"]')" == "running" ]]; then
      health_after_restart="yes"
      break
    fi
  fi
  if (( dry == 1 )); then break; fi
  sleep 0.5
done
record "restart_status_healthy: $health_after_restart"
if [[ "$health_after_restart" == yes ]]; then
  record "restart_generation_after: $(pyq "$WORK/status-2.json" 'd["generation"]')"
  record "restart_chrome: $(pyq "$WORK/status-2.json" 'd["chrome"]')"
  say "after restart: chrome $(pyq "$WORK/status-2.json" 'd["chrome"]'), generation $(pyq "$WORK/status-2.json" 'd["generation"]') (was $generation_before)"
else
  capture_file "$WORK/journal-restart-failed.txt" journal_tail journalctl --user -u leash.service -n 30 --no-pager || true
  show "journalctl after the restart" "$(cat "$WORK/journal-restart-failed.txt" 2>/dev/null)" 30
  say "WARNING: leash status never became healthy after the restart; see the journal above."
fi
capture_file "$WORK/unit-after-restart.txt" unit_show systemctl --user show leash.service -p ActiveState,SubState,ExecMainStatus,Result,NRestarts || true
record "unit_after_restart: $(tr '\n' ' ' <"$WORK/unit-after-restart.txt")"
if [[ -n "$have_niri" ]]; then
  capture_file "$WORK/niri-windows-after-restart.json" niri_windows_after_restart niri msg --json windows || true
  capture_file "$WORK/niri-workspaces-after-restart.json" niri_workspaces niri msg --json workspaces || true
  niri_summary "$WORK/niri-windows-after-restart.json" "$WORK/niri-workspaces-after-restart.json" >"$WORK/summary-niri-after-restart.txt"
  show "niri windows (app-id leash) after the restart (fresh Chrome)" "$(cat "$WORK/summary-niri-after-restart.txt")" 6
  record "niri_after_restart: $(tr '\n' ' ' <"$WORK/summary-niri-after-restart.txt")"
fi
if try old_tab_reply "fail:text_after_restart" "$LEASH" text "$handoff_tab" --max-chars 80; then
  old_tab_verdict="still reachable (UNEXPECTED after a restart)"
else
  old_tab_verdict="tab-gone"
fi
printf '%s' "${old_tab_reply:-}" >"$WORK/old-tab-after-restart.json"
record "old_tab_after_restart: $old_tab_verdict"
record "old_tab_after_restart_reply: ${old_tab_reply:-(no reply)}"
capture_file "$WORK/list-after-restart.json" list_all_empty "$LEASH" list || true
record "tabs_after_restart: $(pyq "$WORK/list-after-restart.json" 'len(d.get("tabs") or [])')"
if (( dry )); then
  profile_after="$(fixture_text profile)"
  chrome_after="$(fixture_text chrome_procs)"
else
  profile_after="$(profile_stats "$profile_dir")"
  chrome_after="$(chrome_processes "$profile_dir")"
fi
record "profile_after_restart: $profile_after"
record "chrome_processes_after_restart: $chrome_after"
ask q_login "If you signed into a site in the managed Chrome lately, did that login survive the restart? [y/n/na]" "na"
record "user_login_survived: $q_login"

say "stopping the unit: systemctl --user stop leash.service"
stop_rc=0
try sysctl_stop_reply "" systemctl --user stop leash.service || stop_rc=$?
record "stop_exit: $stop_rc"
sleep 1
capture_file "$WORK/unit-after-stop.txt" unit_show_after_stop systemctl --user show leash.service -p ActiveState,SubState,ExecMainStatus,Result,NRestarts || true
record "unit_after_stop: $(tr '\n' ' ' <"$WORK/unit-after-stop.txt")"
service_stop_summary="systemctl --user stop -> $(tr '\n' ' ' <"$WORK/unit-after-stop.txt")"
stop_status_rc=0
try status_after_stop "fail:status_after_stop" "$LEASH" status || stop_status_rc=$?
record "status_after_stop_exit: $stop_status_rc"
record "status_after_stop_reply: ${status_after_stop:-(no reply)}"
socket_path="/run/user/$(id -u)/leash/control.sock"
if (( dry )); then
  socket_after_stop="(dry-run: not checked)"
else
  if [[ -S "$socket_path" ]]; then socket_after_stop="present (UNEXPECTED)"; else socket_after_stop="gone"; fi
fi
record "socket_after_stop: $socket_after_stop ($socket_path)"
if (( dry )); then
  chrome_after_stop="0 (dry-run)"
else
  chrome_after_stop="$(chrome_processes "$profile_dir")"
fi
record "chrome_processes_after_stop: $chrome_after_stop"
capture_file "$WORK/journal-tail.txt" journal_tail journalctl --user -u leash.service -n 20 --no-pager || true
show "journalctl --user -u leash.service -n 20" "$(cat "$WORK/journal-tail.txt" 2>/dev/null)" 20
capture_file "$WORK/journal-run-final.json" journal_run journalctl --user -u leash.service --since "$start_stamp" --no-pager || true
journal_command="$(journal_command_cmds "$WORK/journal-run-final.json")"
IFS=$'\t' read -r journal_command_records journal_command_cmd_list <<<"$journal_command"
record "journal_command_records_total: $journal_command_records"
record "journal_command_cmds_total: $journal_command_cmd_list"
journal_warn="$(grep -c 'chrome generation lost' "$WORK/journal-run-final.json" 2>/dev/null || true)"
record "journal_generation_lost_lines: ${journal_warn:-0}"
journal_sample="$(grep -m1 '"cmd"' "$WORK/journal-run-final.json" 2>/dev/null | cut -c1-240 || true)"
record "journal_sample_line: ${journal_sample:-(none)}"
say "journal: $journal_command_records record(s); generation-lost lines: ${journal_warn:-0}"

ask_yn start_again "Start leash.service again so your desktop service is left running?" y
if [[ "$start_again" == y ]]; then
  run "" systemctl --user start leash.service
  final_health="no"
  for _ in $(seq 1 120); do
    if capture_file "$WORK/status-3.json" status_after_restart "$LEASH" status; then
      if [[ "$(pyq "$WORK/status-3.json" 'd["chrome"]')" == "running" ]]; then
        final_health="yes"
        break
      fi
    fi
    if (( dry == 1 )); then break; fi
    sleep 0.5
  done
  record "final_start: yes (leash status healthy: $final_health)"
  say "leash.service is running again ($([[ "$final_health" == yes ]] && echo healthy || echo 'status not healthy yet'))"
else
  record "final_start: no (the unit is left stopped)"
fi

# ------------------------------------------------------------------------- 7. result
section "7. summary"
record "result: finished"
record "elapsed_s: $(( $(date +%s) - start_epoch ))"
run_result="finished"
finished=1
write_results

printf '\n================ %s ================\n' "$result_file"
cat "$result_file"
printf '================ end ================\n'
printf '\n================ %s (L18) ================\n' "$m4_result_file"
cat "$m4_result_file"
printf '================ end ================\n'
printf '\nPaste both blocks back to the agent.\n'
say ""
say "artifacts kept in $WORK (niri dumps, snapshots, screenshot, transcript)."
