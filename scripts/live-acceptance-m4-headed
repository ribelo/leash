#!/usr/bin/env bash
# MANUAL HEADED RUN — FOR THE USER ON THE DESKTOP. DO NOT RUN HEADLESS, DO NOT
# RUN FROM AN AGENT, AND NEVER POINT A HEADLESS GATE AT A REAL DESKTOP.
#
# Milestone-4 headed acceptance (L18, second half): the one handoff a human
# must witness. It starts the real service with a HEADED Chrome on a throwaway
# profile, opens one tab, and runs one handoff with the service defaults:
# real niri window focus and real notify-send with a Done action. You watch
# what the desktop does, click Done (or resume from a terminal), and answer
# three questions. The script records whether the tab resumed and what niri
# did with the managed window (--class=leash), and writes a result file you
# paste back to the agent.
#
# Prerequisites on this machine: niri running, notify-send installed, Chrome
# available, nix develop working (same as the headless gates).
#
# Usage: scripts/live-acceptance-m4-headed [--binary /path/to/chrome]
# Result: /tmp/leash-m4-headed-result.txt (printed at the end; paste it back).
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ "${1:-}" != "--inside-nix" ]]; then
  exec nix develop -c bash "$0" --inside-nix "$@"
fi
shift
binary="$(command -v google-chrome-stable || command -v chromium)"
if [[ "${1:-}" == "--binary" ]]; then binary="$(realpath "$2")"; shift 2; fi
if [[ "$#" != 0 ]]; then echo "usage: $0 [--binary PATH]" >&2; exit 2; fi
binary="$(realpath "$binary")"
RESULT=/tmp/leash-m4-headed-result.txt
echo "=== Leash M4 headed acceptance (manual) ==="
echo "This will open a HEADED Chrome window on a throwaway profile and send one"
echo "real desktop notification. Your current windows stay untouched, but a Chrome"
echo "window will appear and may take focus — that IS the test."
echo
read -r -p "Continue? [y/N] " go
if [[ "$go" != y && "$go" != Y ]]; then echo "aborted; nothing started."; exit 0; fi
dune build @install
leash="$(pwd)/_build/default/packages/leash/bin/main.exe"
root="$(mktemp -d)"
chmod 700 "$root"
export XDG_RUNTIME_DIR="$root/runtime"
mkdir -m 700 "$XDG_RUNTIME_DIR"
profile="$root/profile"
config="$root/leash.toml"
log="$root/service.log"
niri_before="$root/niri-before.json"
niri_after="$root/niri-after.json"
# No [handoff] section: the service defaults are exactly what this run
# exercises (niri focus by {window_id}, notify-send Done action).
cat > "$config" <<EOF
[chrome]
binary = "$binary"
profile_dir = "$profile"
workspace = "test"
headless = false
[tabs]
cap = 12
[expiry]
idle_s = 3600
tombstone_s = 3600
[models]
jev_model = "not-used"
text_model = "not-used"
EOF
service_pid=""
cleanup() {
  if [[ -n "$service_pid" ]] && kill -0 "$service_pid" 2>/dev/null; then
    kill -TERM "$service_pid" || :
    wait "$service_pid" || :
  fi
  rm -rf "$root"
}
trap cleanup EXIT
have_niri=1; command -v niri >/dev/null || have_niri=""
have_notify=1; command -v notify-send >/dev/null || have_notify=""
{
  echo "result: started (overwrite when finished)"
  echo "date: $(date -u +%FT%TZ)"
  echo "niri_present: $([[ -n "$have_niri" ]] && echo yes || echo no)"
  echo "notify_send_present: $([[ -n "$have_notify" ]] && echo yes || echo no)"
} > "$RESULT"
if [[ -n "$have_niri" ]]; then niri msg --json windows >"$niri_before" 2>/dev/null || echo '[]' >"$niri_before"; else echo '[]' >"$niri_before"; fi
"$leash" serve --config "$config" >"$log" 2>&1 &
service_pid=$!
socket="$XDG_RUNTIME_DIR/leash/control.sock"
for _ in $(seq 1 100); do
  if [[ -S "$socket" ]]; then break; fi
  if ! kill -0 "$service_pid" 2>/dev/null; then
    echo "ERROR: Leash exited before socket appeared" >&2
    sed -n '1,100p' "$log" >&2; exit 1
  fi
  sleep 0.1
done
new="$("$leash" new)"
tab="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["tab"])' <<< "$new")"
echo "opened tab $tab (about:blank)"
echo
echo "--- what should happen next ---"
echo "1. A HEADED Chrome window (application class 'leash') should come to the"
echo "   front on the new tab. Note whether it did, and whether it stole focus"
echo "   from what you were doing."
echo "2. A desktop notification should appear with this reason:"
echo "     Headed acceptance: please press Done in this notification"
echo "   and a Done button. Note whether the text and the button are there."
echo "3. Either click Done in the notification, or run this in another terminal:"
echo "     XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR $leash resume $tab"
echo "   The handoff below waits up to 5 minutes, then times out (a timeout is a"
echo "   recorded result, not a crash — but prefer Done so the action path is tested)."
echo "-------------------------------"
echo
reason="Headed acceptance: please press Done in this notification"
"$leash" handoff "$tab" "$reason" --timeout-s 300 >"$root/handoff.json" 2>"$root/handoff.err" &
handoff_pid=$!
sleep 3
if [[ -n "$have_niri" ]]; then niri msg --json windows >"$niri_after" 2>/dev/null || echo '[]' >"$niri_after"; else echo '[]' >"$niri_after"; fi
summarize() {
  python3 - "$1" <<'PY'
import json,sys
try:
    windows = json.load(open(sys.argv[1]))
except Exception as exc:
    print(f"(could not parse {sys.argv[1]}: {exc})")
    sys.exit(0)
for w in windows if isinstance(windows, list) else []:
    if w.get("app_id") == "leash" or "leash" in str(w.get("title", "")).lower():
        print(json.dumps({k: w.get(k) for k in ("id", "app_id", "title", "workspace", "focused", "visible")}))
PY
}
echo "niri windows matching app_id leash right after the handoff started:"
summarize "$niri_after"
echo
read -r -p "Q1: did the Chrome window come to the front? [y/n] " q_focus
read -r -p "Q2: did the notification show the reason above with a Done button? [y/n] " q_notify
echo "Now click Done in the notification (or resume from another terminal), then press ENTER here."
read -r -p ""
if kill -0 "$handoff_pid" 2>/dev/null; then
  echo "(handoff still waiting — giving it 60 more seconds for the Done click...)"
  for _ in $(seq 1 60); do kill -0 "$handoff_pid" 2>/dev/null || break; sleep 1; done
fi
if kill -0 "$handoff_pid" 2>/dev/null; then
  echo "(still waiting; stopping the handoff now — result will be timeout)"
  kill -TERM "$handoff_pid" || :
  wait "$handoff_pid" || :
  handoff_out="(client stopped by the script; service cleared with_human on disconnect)"
else
  wait "$handoff_pid" || :
  handoff_out="$(cat "$root/handoff.json")"
fi
echo
echo "handoff reply: $handoff_out"
resumed="unknown"
if [[ "$handoff_out" == *'"resumed":true'* || "$handoff_out" == *'"resumed": true'* ]]; then resumed=yes; fi
kill -TERM "$service_pid"
if wait "$service_pid"; then service_stop="exit 0"; else service_stop="EXIT NONZERO (see log)"; fi
service_pid=""
{
  echo "result: finished"
  echo "date: $(date -u +%FT%TZ)"
  echo "reason: $reason"
  echo "tab_resumed: $resumed"
  echo "handoff_reply: $handoff_out"
  echo "user_saw_focus: $q_focus"
  echo "user_saw_notification_with_done: $q_notify"
  echo "service_stop: $service_stop"
  echo "--- niri windows (app_id leash) BEFORE the handoff ---"
  summarize "$niri_before"
  echo "--- niri windows (app_id leash) AFTER the handoff started ---"
  summarize "$niri_after"
  echo "--- full niri dumps: pasted inline is too big; files were $niri_before $niri_after (temp dir, deleted on exit) ---"
} > "$RESULT"
echo
echo "================ result file ($RESULT) ================"
cat "$RESULT"
echo "======================================================="
echo "Paste the block above back to the agent. Headed run complete."
