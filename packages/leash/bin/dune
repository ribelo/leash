; hdoc-8c12 hdoc-jh7u hdoc-ztwo: one action builds the embedded skill tree and the
; help topics. errors.md comes from Protocol.Error_code. Flat targets are what
; the diff rules compare to the checked-in copies.

(rule
 (targets
  leash_skill_data.ml
  leash_help_data.ml
  ref_handles.md
  ref_playbooks.md
  ref_authoring.md
  ref_expectations.md
  ref_drive.md
  ref_scripts.md
  ref_errors.md
  ref_traces.md
  ref_browser.md)
 (deps
  gen_skill_data.exe
  gen_error_topic.exe
  ../../../skill/SKILL.md
  ../../../docs/help/handles.md
  ../../../docs/help/playbooks.md
  ../../../docs/help/authoring.md
  ../../../docs/help/expectations.md
  ../../../docs/help/drive.md
  ../../../docs/help/scripts.md
  ../../../docs/help/traces.md
  ../../../docs/help/browser.md)
 (action
  (run
   bash
   -c
   "set -eu; rm -rf skill-tree help-tree; mkdir -p skill-tree/references help-tree; cp \"$1\" skill-tree/SKILL.md; cp \"$2\" skill-tree/references/handles.md; cp \"$2\" help-tree/handles.md; cp \"$2\" ref_handles.md; cp \"$3\" skill-tree/references/playbooks.md; cp \"$3\" help-tree/playbooks.md; cp \"$3\" ref_playbooks.md; cp \"$4\" skill-tree/references/authoring.md; cp \"$4\" help-tree/authoring.md; cp \"$4\" ref_authoring.md; cp \"$5\" skill-tree/references/expectations.md; cp \"$5\" help-tree/expectations.md; cp \"$5\" ref_expectations.md; cp \"$6\" skill-tree/references/drive.md; cp \"$6\" help-tree/drive.md; cp \"$6\" ref_drive.md; cp \"$7\" skill-tree/references/scripts.md; cp \"$7\" help-tree/scripts.md; cp \"$7\" ref_scripts.md; cp \"$8\" skill-tree/references/traces.md; cp \"$8\" help-tree/traces.md; cp \"$8\" ref_traces.md; cp \"$9\" skill-tree/references/browser.md; cp \"$9\" help-tree/browser.md; cp \"$9\" ref_browser.md; ./gen_error_topic.exe > skill-tree/references/errors.md; cp skill-tree/references/errors.md help-tree/errors.md; cp skill-tree/references/errors.md ref_errors.md; ./gen_skill_data.exe skill-tree > leash_skill_data.ml; ./gen_skill_data.exe help-tree topics > leash_help_data.ml"
   --
   %{dep:../../../skill/SKILL.md}
   %{dep:../../../docs/help/handles.md}
   %{dep:../../../docs/help/playbooks.md}
   %{dep:../../../docs/help/authoring.md}
   %{dep:../../../docs/help/expectations.md}
   %{dep:../../../docs/help/drive.md}
   %{dep:../../../docs/help/scripts.md}
   %{dep:../../../docs/help/traces.md}
   %{dep:../../../docs/help/browser.md})))

(rule
 (alias runtest)
 (deps ref_browser.md)
 (action
  (diff ../../../skill/references/browser.md ref_browser.md)))

