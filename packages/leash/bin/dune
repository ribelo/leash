; Local builds read HEAD; source archives/Nix pass LEASH_COMMIT explicitly. The
; universe dependency rechecks HEAD on every build without baking a runtime git call.

(rule
 (target leash_build_commit.ml)
 (deps
  (universe)
  (sandbox none))
 (action
  (with-stdout-to
   leash_build_commit.ml
   (run
    bash
    -c
    "commit=$1; if [ -z \"$commit\" ]; then commit=$(git rev-parse HEAD 2>/dev/null || printf unknown); fi; case \"$commit\" in ''|*[!a-zA-Z0-9._+-]*) commit=unknown;; esac; printf 'let commit = \"%s\"\\n' \"$commit\""
    --
    %{env:LEASH_COMMIT=}))))

