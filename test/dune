(test
 (name learning_operation_test)
 (modules learning_operation_test)
 (deps
  (glob_files fixtures/learning-operations/*.json))
 (libraries leash yojson alcotest))

; Eio_main picks io_uring on Linux; each ring pins locked memory against
; RLIMIT_MEMLOCK, and dune runs suites in parallel, so they fail with ENOMEM in
; io_uring_queue_init. The suites test Leash, not the backend: use eio_posix
; (the spawned main.exe in config_protocol_test inherits it).

(env
 (_
  (env-vars
   (EIO_BACKEND posix)
   ; Tests never see the operator's installed playbooks or config.
   (XDG_CONFIG_HOME /nonexistent/leash-test-config))))

