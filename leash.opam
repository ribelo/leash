opam-version: "2.0"
synopsis: "Leash: a local browser service for coding agents"
description:
  "Leash owns one headed Chrome on a dedicated profile, exposes tabs to agents over a private Unix socket, and drives a tab toward a goal with the JEV decision model."
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.21" & >= "3.21"}
  "eta"
  "eta_app"
  "eta_process"
  "eta_ipc"
  "eta_rpc"
  "eta_json"
  "eta_observability"
  "eta_otel"
  "eta_http"
  "eta_ai"
  "eta_ai_chat"
  "eta_ai_systemone"
  "ppx_yojson_minimal"
  "eta_test" {with-test}
  "eio" {>= "1.0"}
  "eio_main"
  "cmdliner"
  "yojson"
  "toml" {>= "7.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
