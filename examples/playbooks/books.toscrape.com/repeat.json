{
  "site": "books.toscrape.com",
  "entry": "https://books.toscrape.com/",
  "description": "A bookshop catalogue with categories, book titles, prices, ratings, and availability.",
  "pages": [
    {
      "name": "home",
      "description": "The shop front page with the category list",
      "url_pattern": "https://books.toscrape.com/",
      "text_marker": null
    },
    {
      "name": "category",
      "description": "A category listing",
      "url_pattern": "https://books.toscrape.com/catalogue/category/*",
      "text_marker": null
    }
  ],
  "scripts": {
    "list-page": {
      "file": "scripts/list-page.js",
      "returns": [
        {
          "title": "string",
          "price": "number",
          "url": "url",
          "category": "string",
          "rating": "number",
          "availability": "string"
        }
      ]
    },
    "crawl-category": {
      "file": "scripts/crawl-category.js",
      "returns": [
        {
          "title": "string",
          "price": "number",
          "url": "url",
          "category": "string",
          "rating": "number",
          "availability": "string"
        }
      ]
    },
    "category-url": {
      "file": "scripts/category-url.js",
      "returns": {
        "url": "url"
      }
    },
    "next-url": {
      "file": "scripts/next-url.js",
      "returns": {
        "url": "url"
      }
    },
    "last-page": {
      "file": "scripts/last-page.js",
      "returns": {
        "done": "boolean"
      }
    }
  },
  "procedures": [
    {
      "slug": "collect-category",
      "description": "Collect every book in a category.",
      "args": [
        "category"
      ],
      "steps": [
        {
          "navigate": {
            "script": "category-url",
            "args": {
              "category": "{category}"
            }
          }
        },
        {
          "script": "list-page"
        }
      ],
      "expect": [
        "no dialog is open"
      ],
      "repeat": {
        "next": "next-page",
        "max": 60,
        "until": {
          "script": "last-page"
        },
        "delay_ms": 0,
        "key": "url"
      }
    },
    {
      "slug": "next-page",
      "description": "Collect the next page.",
      "steps": [
        {
          "navigate": {
            "script": "next-url"
          }
        },
        {
          "script": "list-page"
        }
      ],
      "expect": [
        "no dialog is open"
      ]
    }
  ]
}
