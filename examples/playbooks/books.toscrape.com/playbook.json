{
  "site": "books.toscrape.com",
  "entry": "https://books.toscrape.com/",
  "description": "A bookshop catalogue with categories, book titles, prices, ratings, and availability.",
  "pages": [
    {
      "name": "home",
      "description": "The shop front page with the category list",
      "url_pattern": "https://books.toscrape.com/",
      "text_marker": null
    },
    {
      "name": "category",
      "description": "A category listing",
      "url_pattern": "https://books.toscrape.com/catalogue/category/*",
      "text_marker": null
    }
  ],
  "scripts": {
    "list-page": {
      "file": "scripts/list-page.js",
      "returns": [
        {
          "title": "string",
          "price": "number",
          "url": "url",
          "category": "string",
          "rating": "number",
          "availability": "string"
        }
      ]
    },
    "crawl-category": {
      "file": "scripts/crawl-category.js",
      "returns": [
        {
          "title": "string",
          "price": "number",
          "url": "url",
          "category": "string",
          "rating": "number",
          "availability": "string"
        }
      ]
    }
  },
  "procedures": [
    {
      "slug": "collect-category",
      "description": "Collect every book in a category.",
      "args": [
        "category"
      ],
      "steps": [
        {
          "script": "crawl-category",
          "args": {
            "category": "{category}"
          }
        }
      ],
      "expect": [
        "no dialog is open"
      ]
    },
    {
      "slug": "collect-category-under",
      "description": "Collect books in a category cheaper than a price limit.",
      "args": [
        "category",
        "max_price"
      ],
      "steps": [
        {
          "script": "crawl-category",
          "args": {
            "category": "{category}",
            "max_price": "{max_price}"
          }
        }
      ],
      "expect": [
        "no dialog is open"
      ]
    }
  ]
}
