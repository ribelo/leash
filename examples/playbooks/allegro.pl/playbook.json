{
  "site": "allegro.pl",
  "entry": "https://allegro.pl/",
  "description": "Find a product on Allegro, inspect an offer, and reach the cart without paying.",
  "pages": [
    {
      "name": "home",
      "description": "Allegro home with search field",
      "url_pattern": "https://allegro.pl/",
      "text_marker": null
    },
    {
      "name": "search",
      "description": "Results of a product search",
      "url_pattern": "https://allegro.pl/listing*",
      "text_marker": null
    },
    {
      "name": "offer",
      "description": "A product offer with add-to-cart action",
      "url_pattern": "https://allegro.pl/oferta/*",
      "text_marker": null
    },
    {
      "name": "cart",
      "description": "Shopping cart listing chosen product",
      "url_pattern": "https://allegro.pl/koszyk*",
      "text_marker": null
    }
  ],
  "procedures": [
    {
      "slug": "find-product",
      "description": "Search Allegro for the named product.",
      "args": [
        "product"
      ],
      "steps": [
        {
          "goal": "Search for {product} on Allegro.",
          "hint": "search"
        }
      ],
      "expect": [
        "the page is search",
        "the page shows {product}"
      ]
    },
    {
      "slug": "open-offer",
      "description": "Open the product offer from results.",
      "args": [
        "product"
      ],
      "steps": [
        {
          "goal": "Open the offer for {product}.",
          "hint": "offer"
        }
      ],
      "expect": [
        "the page is offer"
      ]
    },
    {
      "slug": "add-to-cart",
      "description": "Add this offer to the cart, dismissing any upsell dialog.",
      "args": [],
      "steps": [
        {
          "goal": "Add this product to the cart.",
          "hint": "add to cart"
        },
        {
          "use": "dismiss-upsell",
          "args": {},
          "optional": true
        }
      ],
      "expect": [
        "the page shows cart"
      ]
    },
    {
      "slug": "dismiss-upsell",
      "description": "Close an optional post-add upsell without buying more.",
      "args": [],
      "steps": [
        {
          "goal": "Dismiss the optional extra-offer popup, if shown.",
          "hint": "close"
        }
      ],
      "expect": [
        "no dialog is open"
      ]
    },
    {
      "slug": "go-to-cart",
      "description": "Navigate to the cart and stop before payment.",
      "args": [],
      "steps": [
        {
          "goal": "Open the shopping cart. Do not start checkout or payment.",
          "hint": "cart"
        }
      ],
      "expect": [
        "the page is cart"
      ]
    }
  ]
}
